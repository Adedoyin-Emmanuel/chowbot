PORT=2800
CHOWDECK_API_BASE_URL=https://api.chowdeck.com
CHOWDECK_REQUEST_TIMEOUT_MS=15000
MCP_SERVER_URL=http://localhost:2800/mcp
OAUTH_ISSUER_URL=http://localhost:2800
DATABASE_URL=postgres://admin:admin8080-chowbot@localhost:5432/chowbot
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_SECONDS=10
TEST_DATABASE_URL=postgres://admin:admin8080-chowbot@localhost:5432/chowbot_test
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing it makes stored Chowdeck sessions unreadable.
CHOWBOT_ENCRYPTION_KEY=

# place_order is registered only when this is exactly "true" AND both channel
# values below are set to the captured website values. Keep it false: live
# order placement is not enabled.
CHOWBOT_PLACE_ORDER_ENABLED=false
# Captured from the website on 2026-10-21: methods is sent present but empty.
CHOWBOT_PAYMENT_CHANNEL_METHODS=
CHOWBOT_PAYMENT_CHANNEL_COUNTRY_IDENTIFIER=NG
