PORT=2800
CHOWDECK_API_BASE_URL=https://api.chowdeck.com
CHOWDECK_REQUEST_TIMEOUT_MS=15000
# Where MCP is served. A bare origin serves ,it at the root of the domain.
MCP_SERVER_URL=http://localhost:2800
# The built sign-in app (bun run --filter ./auth build). Defaults to ../auth/dist
# beside this folder, which is also where the container image puts it.
# AUTH_UI_DIR=
# Reverse proxies in front of the server (e.g. 2 for Cloudflare -> Caddy).
# Leave unset when clients connect directly.
# CHOWBOT_TRUST_PROXY_HOPS=
DATABASE_URL=postgres://admin:admin8080-chowbot@localhost:5432/chowbot
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_SECONDS=10
TEST_# Reverse proxies in front of the server (e.g. 2 for Cloudflare -> Caddy).
# Leave unset when clients connect directly.
# CHOWBOT_TRUST_PROXY_HOPS=
DATABASE_URL=postgres://admin:admin8080-chowbot@localhost:5432/chowbot_test
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing it makes stored Chowdeck sessions unreadable.
CHOWBOT_ENCRYPTION_KEY=
