{
  "name": "chowbot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch http.ts",
    "start": "bun http.ts",
    "start:stdio": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./index.ts ./http.ts --target bun --outdir dist",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/express": "^5.0.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  }
}
