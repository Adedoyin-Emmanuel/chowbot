        "order_submissions_state_check": {
          "name": "order_submissions_state_check",
          "value": "\"order_submissions\".\"state\" IN ('quoted', 'confirmation_pending', 'submitting', 'created', 'unknown', 'failed', 'paid', 'released')"
        },
        "order_submissions_ids_check": {
          "name": "order_submissions_ids_check",
          "value": "\"order_submissions\".\"vendor_id\" > 0 AND \"order_submissions\".\"cart_id\" > 0 AND \"order_submissions\".\"fee_id\" > 0"
        },
        "order_submissions_computed_total_check": {
          "name": "order_submissions_computed_total_check",
          "value": "\"order_submissions\".\"computed_total\" > 0"
        },
        "order_submissions_failure_reason_check": {
          "name": "order_submissions_failure_reason_check",
          "value": "(\"order_submissions\".\"state\" = 'failed') = (\"order_submissions\".\"failure_reason\" IS NOT NULL) AND (\"order_submissions\".\"failure_reason\" IS NULL OR \"order_submissions\".\"failure_reason\" IN ('gate_rejected', 'gate_uncertain', 'order_rejected', 'not_sent'))"
        },
        "order_submissions_resolution_check": {
          "name": "order_submissions_resolution_check",
          "value": "\"order_submissions\".\"resolution\" IS NULL OR \"order_submissions\".\"resolution\" IN ('paid_verified', 'linked_user_supplied_order')"
        },
        "order_submissions_lock_release_check": {
          "name": "order_submissions_lock_release_check",
          "value": "(\"order_submissions\".\"lock_released_at\" IS NULL) = (\"order_submissions\".\"lock_release_reason\" IS NULL) AND (\"order_submissions\".\"lock_release_reason\" IS NULL OR \"order_submissions\".\"lock_release_reason\" IN ('cart_changed', 'operator_released'))"
        },
        "order_submissions_confirmation_pending_check": {
          "name": "order_submissions_confirmation_pending_check",
          "value": "\"order_submissions\".\"state\" <> 'confirmation_pending' OR (\"order_submissions\".\"payment_method_id\" IS NOT NULL AND \"order_submissions\".\"confirmation_nonce_hash\" IS NOT NULL AND \"order_submissions\".\"confirmation_expires_at\" IS NOT NULL)"
        },
        "order_submissions_confirmation_expiry_check": {
          "name": "order_submissions_confirmation_expiry_check",
          "value": "\"order_submissions\".\"confirmation_expires_at\" IS NULL OR \"order_submissions\".\"confirmation_expires_at\" <= \"order_submissions\".\"quote_expires_at\""
        },
        "order_submissions_consumed_check": {
          "name": "order_submissions_consumed_check",
          "value": "\"order_submissions\".\"state\" NOT IN ('submitting', 'created', 'unknown', 'paid') OR \"order_submissions\".\"confirmation_consumed_at\" IS NOT NULL"
        },
        "order_submissions_order_id_check": {
          "name": "order_submissions_order_id_check",
          "value": "\"order_submissions\".\"state\" NOT IN ('created', 'paid') OR \"order_submissions\".\"chowdeck_order_id\" IS NOT NULL"
        },
        "order_submissions_marker_check": {
          "name": "order_submissions_marker_check",
          "value": "(\"order_submissions\".\"state\" NOT IN ('quoted', 'confirmation_pending') OR \"order_submissions\".\"order_request_started_at\" IS NULL)\n        AND (\"order_submissions\".\"state\" NOT IN ('created', 'unknown', 'paid') OR \"order_submissions\".\"order_request_started_at\" IS NOT NULL)\n        AND (\"order_submissions\".\"failure_reason\" IS NULL OR \"order_submissions\".\"failure_reason\" NOT IN ('gate_rejected', 'gate_uncertain', 'not_sent') OR \"order_submissions\".\"order_request_started_at\" IS NULL)\n        AND (\"order_submissions\".\"failure_reason\" IS NULL OR \"order_submissions\".\"failure_reason\" <> 'order_rejected' OR \"order_submissions\".\"order_request_started_at\" IS NOT NULL)"
        },
        "order_submissions_payment_start_check": {
          "name": "order_submissions_payment_start_check",
          "value": "(\"order_submissions\".\"payment_started_at\" IS NULL OR \"order_submissions\".\"chowdeck_order_id\" IS NOT NULL)\n        AND (\"order_submissions\".\"payment_start_state\" IS NULL OR \"order_submissions\".\"payment_started_at\" IS NOT NULL)\n        AND (\"order_submissions\".\"payment_start_state\" IS NULL OR \"order_submissions\".\"payment_start_state\" IN ('started', 'rejected', 'unknown'))"
        },
        "order_submissions_paid_after_release_check": {
          "name": "order_submissions_paid_after_release_check",
          "value": "\"order_submissions\".\"paid_after_release_at\" IS NULL OR (\"order_submissions\".\"state\" = 'created' AND \"order_submissions\".\"chowdeck_order_id\" IS NOT NULL AND \"order_submissions\".\"lock_release_reason\" = 'operator_released')"
        }
